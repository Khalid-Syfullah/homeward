# Copy to config.env (same folder) to change the defaults. Every line is optional.

# Command the build check runs after each phase.
# Default: npm run lint, npm run typecheck and npm run build (whichever package.json defines), chained with &&.
# Set to an empty string to turn the check off.
#CHECK_CMD="npm run lint && npm run typecheck && npm run build"

# How many times Claude may try to fix a failing check before it must stop.
MAX_FIX=2

# 1 = commit after each phase (message from prompts/<phase>.commit), 0 = don't commit.
GIT_COMMIT=1

# 1 = push after each commit (default), 0 = don't push.
GIT_PUSH=1
# Remote used the first time a branch is pushed (falls back to the repo's only remote if this one does not exist).
PUSH_REMOTE=origin

# Model for phases not listed in prompts/models.conf: opus or sonnet.
DEFAULT_MODEL=sonnet
# Effort for phases whose line in models.conf has no effort.
DEFAULT_EFFORT=medium
