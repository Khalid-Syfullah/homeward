{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunDeployCommandOnOneInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-southeast-2::document/AWS-RunShellScript",
        "arn:aws:ec2:ap-southeast-2:312605974340:instance/i-06b375f9360b2a8b4"
      ]
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
